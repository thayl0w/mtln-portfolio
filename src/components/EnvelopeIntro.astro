<div id="envelope-overlay" class="envelope-overlay" aria-label="Portfolio introduction">
  <div class="intro-orbit intro-orbit--red" aria-hidden="true"></div>
  <div class="intro-orbit intro-orbit--gold" aria-hidden="true"></div>
  <button id="envelope-open" class="envelope-scene" type="button" aria-label="Open portfolio">
    <span class="envelope-shadow" aria-hidden="true"></span>
    <span class="envelope" aria-hidden="true">
      <span class="envelope-back"></span>
      <span class="envelope-letter"><span class="letter-kicker">Portfolio</span><strong>MTLN</strong><span>Marketing · Automation · Web Systems</span></span>
      <span class="envelope-pocket"></span><span class="envelope-flap"></span><span class="envelope-seal">M</span>
    </span>
    <span class="envelope-hint">Open portfolio</span>
  </button>
  <button id="intro-skip" class="intro-skip" type="button">Skip intro</button>
</div>
<style>
.envelope-overlay{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 50% 38%,rgba(196,43,39,.17),transparent 28%),radial-gradient(circle at 50% 56%,rgba(212,175,55,.08),transparent 34%),linear-gradient(145deg,#0d0e10,#15171b 54%,#101113);color:#f5f1e8;transition:opacity 650ms cubic-bezier(.22,1,.36,1),visibility 650ms ease}.envelope-overlay.is-leaving{opacity:0;visibility:hidden}.intro-orbit{position:absolute;border-radius:999px;filter:blur(85px);pointer-events:none}.intro-orbit--red{width:34rem;height:34rem;background:rgba(166,25,25,.14);top:-17rem;right:-9rem}.intro-orbit--gold{width:28rem;height:28rem;background:rgba(212,175,55,.07);bottom:-15rem;left:-8rem}.envelope-scene{position:relative;width:min(88vw,35rem);min-height:27rem;display:grid;place-items:center;border:0;background:transparent;color:inherit;cursor:pointer;perspective:1200px}.envelope{position:relative;width:min(78vw,26rem);aspect-ratio:1.55/1;transform-style:preserve-3d;transition:transform 900ms cubic-bezier(.22,1,.36,1)}.envelope-scene:hover .envelope{transform:translateY(-6px)}.envelope-shadow{position:absolute;width:min(70vw,23rem);height:3.2rem;top:69%;border-radius:50%;background:rgba(0,0,0,.6);filter:blur(22px);transform:scaleX(.9);transition:transform 900ms ease,opacity 900ms ease}.envelope-back,.envelope-pocket,.envelope-flap{position:absolute;inset:0;border:1px solid rgba(212,175,55,.26)}.envelope-back{border-radius:16px;background:linear-gradient(145deg,#581010,#851616 52%,#4e0d0d);box-shadow:0 34px 80px -38px rgba(0,0,0,.95),inset 0 1px rgba(255,255,255,.08)}.envelope-pocket{z-index:4;border-radius:0 0 16px 16px;clip-path:polygon(0 18%,50% 64%,100% 18%,100% 100%,0 100%);background:linear-gradient(155deg,#6f1111,#a31d1b 52%,#601010)}.envelope-flap{z-index:5;transform-origin:top center;clip-path:polygon(0 0,100% 0,50% 67%);border-radius:16px 16px 0 0;background:linear-gradient(160deg,#b02320,#7c1413 72%);transition:transform 900ms cubic-bezier(.22,1,.36,1);backface-visibility:hidden}.envelope-letter{position:absolute;z-index:3;left:7%;right:7%;top:10%;height:82%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;border:1px solid rgba(212,175,55,.25);border-radius:10px;background:linear-gradient(180deg,#f7f1e5,#e9dfcb);color:#17181b;box-shadow:0 18px 45px rgba(0,0,0,.28);transition:transform 1050ms cubic-bezier(.22,1,.36,1) 220ms}.envelope-letter strong{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2.4rem,10vw,4.3rem);letter-spacing:.08em;color:#8e1716;line-height:1}.envelope-letter span:last-child{padding:0 1.5rem;text-align:center;font-size:.67rem;letter-spacing:.14em;text-transform:uppercase;color:#655f55}.letter-kicker{font-size:.62rem;letter-spacing:.28em;text-transform:uppercase;color:#9a7932}.envelope-seal{position:absolute;z-index:7;left:50%;top:45%;width:3.4rem;height:3.4rem;display:grid;place-items:center;transform:translate(-50%,-50%);border-radius:50%;border:1px solid #f0d477;background:radial-gradient(circle at 35% 30%,#edcf66,#b58b26 58%,#755719);color:#4b0c0b;font-family:Georgia,serif;font-weight:700;font-size:1.2rem;box-shadow:0 8px 22px rgba(0,0,0,.32);transition:opacity 300ms ease,transform 500ms ease}.envelope-hint{position:absolute;bottom:1.7rem;font-size:.7rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#d4af37}.intro-skip{position:absolute;right:1.35rem;top:1.25rem;z-index:3;border:1px solid rgba(212,175,55,.28);border-radius:999px;padding:.55rem .9rem;background:rgba(25,27,31,.7);color:#c9c5bc;font-size:.72rem;cursor:pointer}.envelope-scene.is-opening .envelope-flap{transform:rotateX(178deg)}.envelope-scene.is-opening .envelope-letter{transform:translateY(-48%)}.envelope-scene.is-opening .envelope-seal{opacity:0;transform:translate(-50%,-50%) scale(.65)}.envelope-scene.is-opening .envelope{transform:translateY(18px) scale(1.02)}@media(prefers-reduced-motion:reduce){.envelope,.envelope-flap,.envelope-letter,.envelope-seal,.envelope-overlay{transition-duration:1ms!important}}
</style>
<script>
const KEY='portfolioIntroCompleted';const overlay=document.getElementById('envelope-overlay');const openButton=document.getElementById('envelope-open');const skipButton=document.getElementById('intro-skip');let opening=false;function revealPortfolio(animate=true){const content=document.getElementById('portfolio-content');if(content){content.classList.remove('portfolio-content--hidden');content.classList.add('portfolio-content--revealed');content.setAttribute('aria-hidden','false');if(!animate)content.style.animation='none'}document.body.classList.remove('intro-active');document.body.style.overflow='';document.documentElement.classList.add('intro-completed');document.dispatchEvent(new CustomEvent('portfolio:revealed'))}function finishIntro(immediate=false){try{sessionStorage.setItem(KEY,'true')}catch{}revealPortfolio(!immediate);if(!overlay)return;if(immediate)overlay.remove();else{overlay.classList.add('is-leaving');window.setTimeout(()=>overlay.remove(),700)}}let alreadyDone=false;try{alreadyDone=sessionStorage.getItem(KEY)==='true'}catch{}if(alreadyDone){finishIntro(true)}else{document.body.classList.add('intro-active');openButton?.focus({preventScroll:true});const open=()=>{if(opening)return;opening=true;openButton?.classList.add('is-opening');const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;window.setTimeout(()=>finishIntro(reduced),reduced?30:1450)};openButton?.addEventListener('click',open);skipButton?.addEventListener('click',()=>finishIntro(false))}
</script>
