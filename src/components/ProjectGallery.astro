---
import { projects } from '../data/portfolio';
import { marketingGalleries } from '../data/marketing';

const projectGalleries = Object.fromEntries(
  projects
    .filter((project) => project.gallery?.length)
    .map((project) => [
      project.id,
      {
        title: project.title,
        items: project.gallery,
      },
    ]),
);

const galleries = { ...projectGalleries, ...marketingGalleries };
---

<div
  id="project-gallery-modal"
  class="fixed inset-0 z-[200] hidden items-center justify-center overflow-hidden p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-gallery-title"
  aria-hidden="true"
>
  <div id="project-gallery-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="relative flex max-h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-border bg-surface-alt shadow-2xl shadow-soft">
    <div class="flex shrink-0 items-center gap-3 border-b border-border bg-surface-muted px-4 py-3 sm:px-5">
      <div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-[#FF5F57] ring-1 ring-black/10"></span>
        <span class="h-3 w-3 rounded-full bg-[#FEBC2E] ring-1 ring-black/10"></span>
        <span class="h-3 w-3 rounded-full bg-[#28C840] ring-1 ring-black/10"></span>
      </div>
      <div class="min-w-0 flex-1">
        <h3
          id="project-gallery-title"
          class="truncate rounded-md bg-surface px-3 py-1.5 text-center text-xs font-medium text-muted ring-1 ring-border-light sm:text-sm"
        ></h3>
      </div>
      <button
        id="project-gallery-close"
        type="button"
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-border-light text-muted transition-colors hover:border-accent/50 hover:bg-accent/10 hover:text-accent-light"
        aria-label="Close project gallery"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="relative min-h-0 flex-1 bg-surface-muted">
      <button
        id="project-gallery-prev"
        type="button"
        class="absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white/90 text-navy shadow-soft transition hover:border-accent/40 hover:text-accent"
        aria-label="Previous image"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        id="project-gallery-next"
        type="button"
        class="absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white/90 text-navy shadow-soft transition hover:border-accent/40 hover:text-accent"
        aria-label="Next image"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <p class="pointer-events-none absolute left-0 right-0 top-3 z-10 text-center text-[0.65rem] uppercase tracking-[0.18em] text-gold">
        On-site preview only
      </p>
      <div class="relative flex h-full min-h-[48vh] items-center justify-center overflow-auto p-4 sm:min-h-[58vh] sm:p-6">
        <img
          id="project-gallery-image"
          class="preview-protected max-h-[62vh] w-full rounded-lg object-contain shadow-md"
          draggable="false"
          alt=""
        />
      </div>
    </div>

    <div class="shrink-0 border-t border-border bg-white px-4 py-3 sm:px-5">
      <p id="project-gallery-caption" class="text-sm font-medium text-foreground"></p>
      <p id="project-gallery-count" class="mt-1 text-xs text-muted"></p>
      <div id="project-gallery-thumbs" class="mt-3 flex gap-2 overflow-x-auto pb-1"></div>
    </div>
  </div>
</div>

<script id="project-galleries-data" type="application/json" set:html={JSON.stringify(galleries)} />

<script>
  type GalleryItem = { src: string; alt: string; caption?: string };
  type Gallery = { title: string; items: GalleryItem[] };

  function setupProjectGallery() {
    const modal = document.getElementById('project-gallery-modal');
    const backdrop = document.getElementById('project-gallery-backdrop');
    const closeBtn = document.getElementById('project-gallery-close');
    const prevBtn = document.getElementById('project-gallery-prev');
    const nextBtn = document.getElementById('project-gallery-next');
    const image = document.getElementById('project-gallery-image') as HTMLImageElement | null;
    const titleEl = document.getElementById('project-gallery-title');
    const captionEl = document.getElementById('project-gallery-caption');
    const countEl = document.getElementById('project-gallery-count');
    const thumbs = document.getElementById('project-gallery-thumbs');
    const dataEl = document.getElementById('project-galleries-data');

    if (!modal || !image || !titleEl || !dataEl) return;
    if (modal.dataset.bound === 'true') return;

    const galleries = JSON.parse(dataEl.textContent || '{}') as Record<string, Gallery>;
    let items: GalleryItem[] = [];
    let index = 0;
    let lastFocused: HTMLElement | null = null;
    let savedScrollY = 0;

    function lockScroll() {
      savedScrollY = window.scrollY;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }

    function unlockScroll() {
      document.documentElement.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo({ top: savedScrollY, left: 0, behavior: 'instant' });
    }

    function render() {
      const item = items[index];
      if (!item) return;
      image.src = item.src;
      image.alt = item.alt;
      if (captionEl) captionEl.textContent = item.caption || item.alt;
      if (countEl) countEl.textContent = `${index + 1} of ${items.length}`;
      thumbs?.querySelectorAll<HTMLButtonElement>('button').forEach((thumb, thumbIndex) => {
        thumb.classList.toggle('ring-2', thumbIndex === index);
        thumb.classList.toggle('ring-accent', thumbIndex === index);
        thumb.classList.toggle('opacity-60', thumbIndex !== index);
      });
    }

    function buildThumbs() {
      if (!thumbs) return;
      thumbs.replaceChildren();
      items.forEach((item, itemIndex) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className =
          'h-14 w-20 shrink-0 overflow-hidden rounded-md border border-border bg-surface-muted transition hover:opacity-100';
        button.setAttribute('aria-label', `Show ${item.alt}`);
        const thumb = document.createElement('img');
        thumb.src = item.src;
        thumb.alt = '';
        thumb.draggable = false;
        thumb.className = 'preview-protected h-full w-full object-cover object-top';
        button.appendChild(thumb);
        button.addEventListener('click', () => {
          index = itemIndex;
          render();
        });
        thumbs.appendChild(button);
      });
    }

    function openGallery(id: string, startIndex = 0) {
      const gallery = galleries[id];
      if (!gallery?.items?.length) return;
      lastFocused = document.activeElement as HTMLElement;
      items = gallery.items;
      index = Math.min(Math.max(startIndex, 0), items.length - 1);
      titleEl.textContent = gallery.title;
      buildThumbs();
      render();
      lockScroll();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      closeBtn?.focus({ preventScroll: true });
    }

    function closeGallery() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      image.src = '';
      unlockScroll();
      lastFocused?.focus({ preventScroll: true });
    }

    function step(delta: number) {
      if (!items.length) return;
      index = (index + delta + items.length) % items.length;
      render();
    }

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-project-gallery]');
      if (!trigger) return;
      event.preventDefault();
      openGallery(trigger.dataset.projectGallery || '', Number(trigger.dataset.galleryIndex || 0));
    });

    document.addEventListener('keydown', (event) => {
      if (modal.classList.contains('hidden')) return;
      if (event.key === 'Escape') closeGallery();
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });

    closeBtn?.addEventListener('click', closeGallery);
    backdrop?.addEventListener('click', closeGallery);
    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));

    modal.dataset.bound = 'true';
  }

  setupProjectGallery();
  document.addEventListener('astro:page-load', setupProjectGallery);
</script>
