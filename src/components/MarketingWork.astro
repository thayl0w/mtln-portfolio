---
import { getMarketingBrands, marketingCategories, marketingCounts } from '../data/marketing';

const brands = getMarketingBrands();
---

<section id="marketing" class="section-fade py-12 md:py-16">
  <div class="section-container">
    <div class="mb-10 max-w-3xl space-y-3">
      <p class="section-eyebrow">Marketing work</p>
      <h2 class="section-heading">Marketing Work</h2>
      <p class="section-subheading">
        Websites, funnels, social media &amp; graphics, lead magnets, and automation &amp; workflows — grouped by brand inside each category.
      </p>
    </div>

    <div class="mb-8 flex flex-wrap gap-2" aria-label="Browse by brand">
      {
        brands.map((brand) => (
          <a href={`/marketing/brand/${brand.id}`} class="btn-outline !rounded-full !px-3.5 !py-1.5 text-sm">
            {brand.brand}
          </a>
        ))
      }
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        marketingCategories.map((category) => {
          const counts = marketingCounts(category);
          return (
            <a
              href={`/marketing/${category.id}`}
              class="card-surface group flex h-full flex-col p-6 transition-transform duration-300 hover:-translate-y-1"
            >
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-gold">
                {category.eyebrow}
              </p>
              <h3 class="mt-3 font-serif text-2xl font-semibold text-foreground group-hover:text-gold-light">
                {category.title}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{category.summary}</p>
              <p class="mt-5 text-xs uppercase tracking-[0.14em] text-subtle">
                {counts.items} item{counts.items === 1 ? '' : 's'} · {counts.brands} brand
                {counts.brands === 1 ? '' : 's'}
              </p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-gold-light">
                {category.explore}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
