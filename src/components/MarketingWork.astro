---
import { getMarketingBrands, getMarketingWindows, marketingCategories, marketingCounts } from '../data/marketing';
import CompactProjectCard from './CompactProjectCard.astro';
import ProjectCarousel from './ProjectCarousel.astro';

const brands = getMarketingBrands();
const windows = getMarketingWindows();
---

<section id="marketing" class="section-fade py-12 md:py-16">
  <div class="section-container">
    <div class="mb-10 max-w-3xl space-y-3">
      <p class="section-eyebrow">Marketing work</p>
      <h2 class="section-heading">Marketing Work</h2>
      <p class="section-subheading">
        Websites, funnels, social media &amp; graphics, lead magnets, and automation &amp; workflows — grouped by brand inside each category.
      </p>
    </div>

    <div class="mb-10 flex flex-wrap gap-2" aria-label="Browse by brand">
      {
        brands.map((brand) => (
          <a href={`/marketing/brand/${brand.id}`} class="btn-outline !rounded-full !px-3.5 !py-1.5 text-sm">
            {brand.brand}
          </a>
        ))
      }
    </div>

    <div class="space-y-12">
      {
        marketingCategories.map((category) => {
          const counts = marketingCounts(category);
          const projects = windows.filter((window) => window.category.id === category.id);
          return (
            <section id={`marketing-${category.id}`} class="scroll-mt-28">
              <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
                <div>
                  <h3 class="font-serif text-2xl font-semibold text-foreground">{category.title}</h3>
                  <p class="mt-1 text-xs uppercase tracking-[0.14em] text-subtle">
                    {counts.projects} project{counts.projects === 1 ? '' : 's'} · {counts.brands} brand{counts.brands === 1 ? '' : 's'}
                  </p>
                </div>
                <a href={`/marketing/${category.id}`} class="text-sm font-semibold text-gold-light">
                  {category.explore} →
                </a>
              </div>
              <ProjectCarousel label={category.title}>
                {
                  projects.map((project) => (
                    <div class="carousel-card">
                      <CompactProjectCard
                        href={project.href}
                        image={project.preview}
                        eyebrow={category.title}
                        title={project.brand}
                        summary={project.summary}
                      />
                    </div>
                  ))
                }
              </ProjectCarousel>
            </section>
          );
        })
      }
    </div>
  </div>
</section>
