---
import { site } from '../data/portfolio';
import ResumePreviewButton from './ResumePreviewButton.astro';
---

<section id="hero" class="hero-section relative overflow-hidden pb-14 pt-28 md:pb-20 md:pt-32">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-20 right-0 h-[420px] w-[420px] rounded-full bg-accent/20 blur-[100px] animate-glow-pulse"></div>
    <div class="absolute bottom-0 left-[-4rem] h-[320px] w-[320px] rounded-full bg-gold/10 blur-[90px]"></div>
  </div>

  <div class="section-container relative z-10">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)]">
      <div class="space-y-6 md:space-y-7">
        <p class="text-eyebrow text-gold animate-fade-in">
          {site.tagline}
        </p>

        <h1 class="hero-title text-display font-serif text-navy animate-slide-up">
          {site.heroHeadline}
        </h1>

        <p class="max-w-2xl text-hero text-muted animate-slide-up" style="animation-delay: 0.08s">
          {site.shortPitch}
        </p>

        <div class="flex flex-wrap gap-4 animate-slide-up" style="animation-delay: 0.14s">
          <a href="#marketing" class="btn-primary">
            <span>Explore Marketing Work</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
          <a href="#contact" class="btn-secondary">Contact Me</a>
          <ResumePreviewButton class="btn-outline" />
        </div>

        <div class="flex flex-wrap items-center gap-3 animate-slide-up" style="animation-delay: 0.2s">
          <span class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-accent/15 px-3 py-1 text-xs font-semibold text-gold-light">
            <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
            Open for work
          </span>
          <span class="text-sm text-muted">{site.availability}</span>
        </div>
      </div>

      <div class="glass-panel overflow-hidden p-3 animate-slide-up" style="animation-delay: 0.16s">
        <div class="space-y-5">
          <div class="overflow-hidden rounded-xl border border-border/80 bg-surface-muted">
            <img
              src={site.photoUrl}
              alt={site.name}
              class="aspect-[4/5] w-full object-cover object-top"
              width="640"
              height="800"
            />
          </div>
          <div class="px-3 pb-2">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-subtle">Available for hire</p>
                <p class="mt-2 text-2xl font-semibold text-foreground">{site.name}</p>
                <p class="mt-1 text-sm font-medium text-muted">{site.tagline}</p>
              </div>
            </div>
          </div>

          <div class="space-y-2 rounded-xl border border-border/90 bg-surface-muted p-4 text-sm">
            <p class="text-subtle">Current focus</p>
            <p class="font-medium text-foreground">{site.currentFocus}</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-border/90 bg-surface-muted p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-subtle">Location</p>
              <p class="mt-2 text-sm font-semibold text-foreground">{site.location}</p>
            </div>
            <div class="rounded-xl border border-border/90 bg-surface-muted p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-subtle">Availability</p>
              <p class="mt-2 text-sm font-semibold text-foreground">Open for roles</p>
            </div>
          </div>

          <div class="space-y-3">
            {site.valueProps.map((item) => (
              <p class="text-sm text-muted">{item}</p>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-4">
      {
        site.stats.map((stat) => (
          <div class="card-surface p-5">
            <p class="text-xs uppercase tracking-[0.18em] text-subtle">{stat.label}</p>
            <p class="mt-2 text-2xl font-semibold text-foreground">{stat.value}</p>
            <p class="mt-2 text-sm text-muted">{stat.context}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-section {
    scroll-margin-top: 6rem;
  }

  .hero-title {
    line-height: 1.08;
  }
</style>
