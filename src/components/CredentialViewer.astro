---
import docPreviews from '../data/docPreviews.json';
---

<div
  id="credential-modal"
  class="fixed inset-0 z-[200] hidden items-center justify-center overflow-hidden p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="credential-modal-title"
  aria-hidden="true"
>
  <div id="credential-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="relative flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-border bg-surface-alt shadow-2xl shadow-soft">
    {/* Window chrome — matches credential / project card style */}
    <div class="flex shrink-0 items-center gap-3 border-b border-border bg-surface-muted px-4 py-3 sm:px-5">
      <div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-[#FF5F57] ring-1 ring-black/10" aria-hidden="true" />
        <span class="h-3 w-3 rounded-full bg-[#FEBC2E] ring-1 ring-black/10" aria-hidden="true" />
        <span class="h-3 w-3 rounded-full bg-[#28C840] ring-1 ring-black/10" aria-hidden="true" />
      </div>
      <div class="min-w-0 flex-1">
        <h3 id="credential-modal-title" class="truncate rounded-md bg-surface px-3 py-1.5 text-center text-xs font-medium text-muted ring-1 ring-border-light sm:text-sm"></h3>
      </div>
      <button
        id="credential-close"
        type="button"
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-border-light text-muted transition-colors hover:border-accent/50 hover:bg-accent/10 hover:text-accent-light"
        aria-label="Close credential viewer"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <p class="shrink-0 border-b border-border bg-surface px-4 py-2 text-center text-[0.7rem] uppercase tracking-[0.16em] text-gold">
      On-site preview only
    </p>

    <div id="credential-pdf-container" class="relative min-h-0 flex-1 overflow-hidden bg-surface-muted">
      <iframe
        id="credential-iframe"
        class="h-full min-h-[60vh] w-full border-0 sm:min-h-[70vh]"
        title="Credential document viewer"
        referrerpolicy="no-referrer"
      ></iframe>
      <div class="preview-watermark">Preview</div>
    </div>

    <div id="credential-image-container" class="relative hidden min-h-0 flex-1 overflow-hidden bg-surface-muted p-4 sm:p-6">
      <img
        id="credential-image"
        class="preview-protected mx-auto h-full max-h-[70vh] w-full rounded-lg object-contain shadow-md"
        alt=""
        draggable="false"
      />
      <div class="preview-watermark">Preview</div>
    </div>

    <div id="credential-text-container" class="hidden min-h-0 flex-1 overflow-auto bg-surface-muted p-5 sm:p-6">
      <div id="credential-text" class="mx-auto max-w-2xl space-y-3 text-sm leading-relaxed text-muted"></div>
    </div>
  </div>
</div>

<script id="doc-previews-data" type="application/json" set:html={JSON.stringify(docPreviews)} />

<script>
  function isPdf(url: string) {
    return url.toLowerCase().endsWith('.pdf');
  }

  function setupCredentialViewer() {
    const modal = document.getElementById('credential-modal');
    const backdrop = document.getElementById('credential-backdrop');
    const closeBtn = document.getElementById('credential-close');
    const iframe = document.getElementById('credential-iframe') as HTMLIFrameElement | null;
    const pdfContainer = document.getElementById('credential-pdf-container');
    const imageContainer = document.getElementById('credential-image-container');
    const textContainer = document.getElementById('credential-text-container');
    const textEl = document.getElementById('credential-text');
    const image = document.getElementById('credential-image') as HTMLImageElement | null;
    const modalTitle = document.getElementById('credential-modal-title');
    const previewDataEl = document.getElementById('doc-previews-data');
    const docPreviews = JSON.parse(previewDataEl?.textContent || '{}') as Record<string, string[]>;

    if (!modal || !modalTitle) return;

    let lastFocused: HTMLElement | null = null;
    let savedScrollY = 0;
    let isBound = modal.dataset.bound === 'true';

    function lockScroll() {
      savedScrollY = window.scrollY;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
    }

    function unlockScroll() {
      document.documentElement.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo({ top: savedScrollY, left: 0, behavior: 'instant' });
    }

    function showOnly(which: 'pdf' | 'image' | 'text') {
      pdfContainer?.classList.toggle('hidden', which !== 'pdf');
      imageContainer?.classList.toggle('hidden', which !== 'image');
      textContainer?.classList.toggle('hidden', which !== 'text');
    }

    function openModal(documentUrl: string, title: string) {
      lastFocused = document.activeElement as HTMLElement;
      modalTitle.textContent = title;

      const isDoc = /\.docx?$/i.test(documentUrl);
      if (isDoc) {
        showOnly('text');
        if (iframe) iframe.src = '';
        if (image) image.src = '';
        const lines = docPreviews[documentUrl] || [];
        if (textEl) {
          textEl.replaceChildren();
          if (!lines.length) {
            const empty = document.createElement('p');
            empty.textContent = 'Preview is available on this page only. The original file is not offered for download.';
            textEl.appendChild(empty);
          } else {
            lines.forEach((line) => {
              const p = document.createElement('p');
              p.textContent = line;
              textEl.appendChild(p);
            });
            const note = document.createElement('p');
            note.className = 'pt-4 text-xs uppercase tracking-[0.14em] text-gold';
            note.textContent = 'Preview excerpt — full file is not available for download.';
            textEl.appendChild(note);
          }
        }
      } else if (isPdf(documentUrl)) {
        showOnly('pdf');
        if (image) image.src = '';
        if (iframe) iframe.src = `${documentUrl}#view=FitH&toolbar=0&navpanes=0&scrollbar=0`;
      } else {
        showOnly('image');
        if (iframe) iframe.src = '';
        if (image) {
          image.src = documentUrl;
          image.alt = title;
        }
      }

      lockScroll();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      closeBtn?.focus({ preventScroll: true });
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      if (iframe) iframe.src = '';
      if (image) image.src = '';
      if (textEl) textEl.replaceChildren();
      unlockScroll();
      lastFocused?.focus({ preventScroll: true });
    }

    if (!isBound) {
      function tryOpenFromTrigger(trigger: HTMLElement | null, event?: Event) {
        if (!trigger) return;
        // Don't open when clicking controls inside the modal itself
        if (trigger.closest('#credential-modal')) return;

        const documentUrl = trigger.dataset.document;
        const title = trigger.dataset.title;
        if (documentUrl && title) {
          event?.preventDefault();
          event?.stopPropagation();
          openModal(documentUrl, title);
        }
      }

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const trigger = target.closest<HTMLElement>('[data-document][data-title]');
        tryOpenFromTrigger(trigger, event);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModal();
          return;
        }

        if (event.key !== 'Enter' && event.key !== ' ') return;
        const target = event.target as HTMLElement;
        const trigger = target.closest<HTMLElement>('[data-document][data-title][role="button"]');
        if (!trigger || target !== trigger) return;
        tryOpenFromTrigger(trigger, event);
      });

      closeBtn?.addEventListener('click', (event) => {
        event.stopPropagation();
        closeModal();
      });
      backdrop?.addEventListener('click', closeModal);

      modal.dataset.bound = 'true';
    }
  }

  setupCredentialViewer();
  document.addEventListener('astro:page-load', setupCredentialViewer);
</script>