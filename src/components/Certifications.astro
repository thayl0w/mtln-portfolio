---
import { certifications } from '../data/portfolio';
import CredentialCard from './CredentialCard.astro';
---

<section id="certifications" class="section-fade py-10 md:py-14">
  <div class="section-container">
    <div class="mb-7 max-w-3xl space-y-3 md:mb-8">
      <p class="section-eyebrow">Certifications</p>
      <h2 class="section-heading">Certificates that support the work</h2>
      <p class="section-subheading">
        Completed BYU–Idaho certificates in software development, web development, and computer programming.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {certifications.map((credential) => <CredentialCard credential={credential} />)}
    </div>
  </div>
</section>
