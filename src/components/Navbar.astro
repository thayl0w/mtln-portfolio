---
import { site, navLinks } from '../data/portfolio';
import ResumePreviewButton from './ResumePreviewButton.astro';

interface Props {
  revealImmediately?: boolean;
}

const { revealImmediately = false } = Astro.props;
const linkPrefix = revealImmediately ? '/' : '';
const homeHref = revealImmediately ? '/#hero' : '#hero';
---

<div
  id="nav-shell"
  class:list={['nav-shell', !revealImmediately && 'is-intro-hidden']}
  style="position: fixed; top: 0; left: 0; right: 0; z-index: 50;"
>
  <header
    id="navbar"
    class="nav-bar border-b border-border/70 shadow-soft backdrop-blur-md"
    style="background: rgba(25, 27, 31, 0.92);"
  >
    <nav class="section-container flex items-center justify-between gap-4 py-4">
      <a
        href={homeHref}
        class="text-sm font-semibold tracking-[0.06em] text-foreground transition-colors hover:text-gold-light"
      >
        {site.shortName}
      </a>

      <ul class="hidden items-center gap-1 rounded-full border border-border p-1 md:flex" style="background: #22252a;">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={`${linkPrefix}${link.href}`}
                class="nav-desktop-link relative block rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-all duration-200 hover:bg-surface hover:text-foreground"
                data-section={link.href.replace('#', '')}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hidden items-center gap-2 md:flex">
        <ResumePreviewButton class="btn-outline !px-4 !py-2 text-xs sm:text-sm" />
        <a href={`${linkPrefix}#contact`} class="btn-primary !px-4 !py-2 text-xs sm:text-sm">Let's work together</a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="relative z-50 flex h-10 items-center justify-center rounded-full border border-border bg-surface-muted px-3 text-xs font-semibold text-foreground transition-colors hover:border-gold/40 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        Menu
      </button>
    </nav>

    <div id="mobile-menu" class="hidden border-t border-border/70 md:hidden" style="background: #191b1f;">
      <ul class="section-container flex flex-wrap gap-2 py-3">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={`${linkPrefix}${link.href}`}
                class="mobile-nav-link block rounded-full px-4 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-muted hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="ml-auto flex gap-2">
          <ResumePreviewButton class="btn-outline !py-2 text-xs" />
          <a href={`${linkPrefix}#contact`} class="btn-primary !px-4 !py-2 text-xs">Contact</a>
        </li>
      </ul>
    </div>
  </header>

  <!-- Always-visible chevron to hide / show the sticky nav -->
  <button
    id="nav-collapse-toggle"
    type="button"
    class="nav-collapse-toggle"
    aria-label="Hide navigation"
    aria-expanded="true"
    aria-controls="navbar"
    title="Hide or show navigation"
  >
    <svg
      id="nav-chevron"
      class="nav-chevron h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>
</div>

<style>
  .nav-shell {
    /* Locked to the viewport — only the page body scrolls underneath */
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 50;
    pointer-events: none;
    transition: opacity 0.45s ease, visibility 0.45s ease;
  }

  /* Hidden until envelope intro finishes */
  .nav-shell.is-intro-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .nav-shell:not(.is-intro-hidden) {
    opacity: 1;
    visibility: visible;
  }

  .nav-shell .nav-bar,
  .nav-shell .nav-collapse-toggle {
    pointer-events: auto;
  }

  .nav-bar {
    transform: translateY(0);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease,
      opacity 0.3s ease;
    will-change: transform;
  }

  .nav-shell.is-collapsed .nav-bar {
    transform: translateY(calc(-100% - 2px));
    box-shadow: none !important;
    pointer-events: none;
  }

  .nav-collapse-toggle {
    position: absolute;
    left: 50%;
    top: 100%;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 1.5rem;
    margin-top: -1px;
    transform: translateX(-50%);
    border: 1px solid rgba(58, 63, 70, 0.95);
    border-top: none;
    border-radius: 0 0 0.75rem 0.75rem;
    background: rgba(25, 27, 31, 0.94);
    color: #c9c5bc;
    box-shadow: 0 8px 20px -14px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-collapse-toggle:hover {
    color: #e7c765;
    background: rgba(34, 37, 42, 0.98);
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 10px 24px -12px rgba(166, 25, 25, 0.4);
  }

  .nav-collapse-toggle:focus-visible {
    outline: 2px solid rgba(212, 175, 55, 0.55);
    outline-offset: 2px;
  }

  .nav-chevron {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Expanded: chevron points up (^) — click to hide */
  .nav-shell:not(.is-collapsed) .nav-chevron {
    transform: rotate(180deg);
  }

  /* Collapsed: chevron points down (v) — click to show */
  .nav-shell.is-collapsed .nav-chevron {
    transform: rotate(0deg);
  }

  .nav-shell.is-collapsed .nav-collapse-toggle {
    /* Keep toggle reachable at top of viewport when nav is hidden */
    top: 0;
    margin-top: 0;
    border-top: 1px solid rgba(58, 63, 70, 0.95);
    border-radius: 0 0 0.75rem 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-bar,
    .nav-chevron {
      transition: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'portfolio-nav-collapsed';

  const shell = document.getElementById('nav-shell');
  const navbar = document.getElementById('navbar');
  const collapseToggle = document.getElementById('nav-collapse-toggle');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-desktop-link');

  let isOpen = false;
  let isCollapsed = false;

  function setMenuOpen(open: boolean) {
    isOpen = open;
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
    if (!document.body.classList.contains('intro-active')) {
      document.body.style.overflow = open ? 'hidden' : '';
    }
  }

  function setNavCollapsed(collapsed: boolean) {
    isCollapsed = collapsed;
    shell?.classList.toggle('is-collapsed', collapsed);
    collapseToggle?.setAttribute('aria-expanded', String(!collapsed));
    collapseToggle?.setAttribute(
      'aria-label',
      collapsed ? 'Show navigation' : 'Hide navigation',
    );
    collapseToggle?.setAttribute(
      'title',
      collapsed ? 'Show navigation' : 'Hide navigation',
    );

    // Close mobile drawer when collapsing the whole nav
    if (collapsed) setMenuOpen(false);

    try {
      localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
    } catch {
      /* ignore */
    }
  }

  // Restore last preference
  try {
    if (localStorage.getItem(STORAGE_KEY) === '1') {
      setNavCollapsed(true);
    }
  } catch {
    /* ignore */
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen) setMenuOpen(false);
  });

  collapseToggle?.addEventListener('click', () => setNavCollapsed(!isCollapsed));

  toggle?.addEventListener('click', () => {
    if (isCollapsed) setNavCollapsed(false);
    setMenuOpen(!isOpen);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  // If intro was already skipped (e.g. reduced motion), show nav immediately
  if (!document.getElementById('envelope-overlay')) {
    shell?.classList.remove('is-intro-hidden');
  }

  document.addEventListener('portfolio:revealed', () => {
    shell?.classList.remove('is-intro-hidden');
  });

  const sectionIds = Array.from(desktopLinks)
    .map((link) => link.dataset.section)
    .filter((id): id is string => Boolean(id));

  function setActiveNav(activeId: string) {
    desktopLinks.forEach((link) => {
      const isActive = link.dataset.section === activeId;
      link.classList.toggle('text-gold-light', isActive);
      link.classList.toggle('bg-accent/20', isActive);
      link.classList.toggle('border', isActive);
      link.classList.toggle('border-gold/30', isActive);
      if (isActive) {
        link.classList.remove('text-muted');
      }
    });
  }

  function syncActiveFromScroll() {
    const anchor = window.scrollY + window.innerHeight * 0.3;
    let active = sectionIds[0] ?? 'hero';

    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const top = window.scrollY + el.getBoundingClientRect().top;
      if (anchor >= top - 24) active = id;
    }

    setActiveNav(active);
  }

  window.addEventListener('scroll', syncActiveFromScroll, { passive: true });
  window.addEventListener('load', syncActiveFromScroll);
  syncActiveFromScroll();
</script>
