---
import type { Credential } from '../data/portfolio';

interface Props {
  credential: Credential;
}

const { credential } = Astro.props;
const hasDocument = Boolean(credential.documentUrl);
const isPdf = hasDocument && credential.documentUrl!.toLowerCase().endsWith('.pdf');
const fileName = hasDocument
  ? credential.documentUrl!.split('/').pop() ?? 'credential.pdf'
  : '';
---

{
  hasDocument ? (
    <article
      class="credential-card card group flex w-full cursor-pointer flex-col overflow-hidden p-0 text-left hover:-translate-y-1"
      data-document={credential.documentUrl}
      data-title={credential.title}
      role="button"
      tabindex="0"
      aria-label={`View ${credential.title}`}
    >
      {/* Window chrome + document preview (project-card style) */}
      <div class="relative overflow-hidden border-b border-border bg-surface-muted">
        {/* Title bar */}
        <div class="flex items-center gap-3 border-b border-border/80 bg-surface-alt px-3 py-2.5">
          <div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57] ring-1 ring-black/10" />
            <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E] ring-1 ring-black/10" />
            <span class="h-2.5 w-2.5 rounded-full bg-[#28C840] ring-1 ring-black/10" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="truncate rounded-md bg-surface px-2.5 py-1 text-center text-[11px] font-medium text-muted ring-1 ring-border-light">
              {fileName}
            </div>
          </div>
          <span class="hidden shrink-0 text-[10px] font-semibold uppercase tracking-wide text-muted-dark sm:inline">
            {credential.kind === 'degree' ? 'Degree' : 'Certificate'}
          </span>
        </div>

        {/* Document viewport */}
        <div class="relative aspect-[4/3] overflow-hidden bg-[#e8ecf0] sm:aspect-video">
          {isPdf ? (
            <div class="absolute inset-0 flex items-start justify-center overflow-hidden p-3 sm:p-4">
              <div class="h-[200%] w-[140%] max-w-none origin-top scale-[0.72] sm:w-[130%] sm:scale-[0.78]">
                <iframe
                  src={`${credential.documentUrl}#view=FitH&toolbar=0&navpanes=0&scrollbar=0`}
                  title={`${credential.title} preview`}
                  class="h-full w-full border-0 bg-white shadow-md pointer-events-none"
                  loading="lazy"
                  tabindex="-1"
                  aria-hidden="true"
                />
              </div>
            </div>
          ) : (
            <div class="absolute inset-0 flex items-center justify-center p-4">
              <img
                src={credential.documentUrl}
                alt=""
                class="max-h-full max-w-full rounded-sm object-contain shadow-md"
                loading="lazy"
              />
            </div>
          )}

          {/* Hover affordance */}
          <div class="pointer-events-none absolute inset-0 bg-accent/0 transition-colors duration-300 group-hover:bg-accent/10" />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-surface-muted/90 to-transparent" />
          <div class="pointer-events-none absolute bottom-3 left-1/2 -translate-x-1/2 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-black/80 px-3 py-1.5 text-xs font-semibold text-foreground shadow-lg backdrop-blur-sm">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
              </svg>
              Click to expand
            </span>
          </div>
        </div>
      </div>

      {/* Card body */}
      <div class="flex flex-1 flex-col p-5 sm:p-6">
        <span
          class:list={[
            'inline-flex w-fit rounded-md px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
            credential.kind === 'degree'
              ? 'bg-accent/15 text-accent'
              : 'bg-accent-light/10 text-accent-light',
          ]}
        >
          {credential.kind === 'degree' ? 'Degree' : 'Certificate'}
        </span>

        <h3 class="mt-2 text-lg font-bold leading-snug text-navy-deep transition-colors group-hover:text-accent-light sm:text-xl">
          {credential.title}
        </h3>

        <p class="mt-2 flex items-start gap-2 text-sm text-muted">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
          </svg>
          {credential.institution}
        </p>

        <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4 mt-5">
          <span class="inline-flex items-center gap-2 text-sm font-medium text-muted">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            {credential.date}
          </span>

          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-dark transition-colors duration-300 group-hover:text-accent-light">
            View full document
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </span>
        </div>
      </div>
    </article>
  ) : (
    <article class="credential-card card group flex w-full flex-col overflow-hidden p-0 text-left">
      <div class="relative overflow-hidden border-b border-border bg-surface-muted">
        <div class="flex items-center gap-3 border-b border-border/80 bg-surface-alt px-3 py-2.5">
          <div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57] ring-1 ring-black/10" />
            <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E] ring-1 ring-black/10" />
            <span class="h-2.5 w-2.5 rounded-full bg-[#28C840] ring-1 ring-black/10" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="truncate rounded-md bg-surface px-2.5 py-1 text-center text-[11px] font-medium text-muted ring-1 ring-border-light">
              {credential.title}
            </div>
          </div>
        </div>
        <div class="flex aspect-video items-center justify-center bg-accent/10">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/20 text-accent-light ring-1 ring-accent/30">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 14l9-5-9-5-9 5 9 5z" />
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824 2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824 2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
          </div>
        </div>
      </div>
      <div class="p-5 sm:p-6">
        <span class="inline-flex rounded-md bg-accent/20 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-accent-dark">
          Degree
        </span>
        <h3 class="mt-2 text-lg font-bold leading-snug text-navy-deep sm:text-xl">{credential.title}</h3>
        <p class="mt-2 text-sm text-muted">{credential.institution}</p>
        <p class="mt-4 text-sm font-medium text-muted-dark">{credential.date}</p>
      </div>
    </article>
  )
}
