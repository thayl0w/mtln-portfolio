---
import { skillCategories } from '../data/portfolio';
import type { SkillCategoryId } from '../data/portfolio';
import SkillIcon from './SkillIcon.astro';

const categoryIcons: Record<SkillCategoryId, { bg: string; ring: string; iconColor: string }> = {
  marketing: { bg: 'bg-accent/15', ring: 'ring-accent/30', iconColor: 'text-accent' },
  web: { bg: 'bg-accent-light/10', ring: 'ring-accent-light/25', iconColor: 'text-accent-light' },
  design: { bg: 'bg-brand-gold/40', ring: 'ring-accent/20', iconColor: 'text-accent-dark' },
  productivity: { bg: 'bg-brand-sky/20', ring: 'ring-brand-sky/30', iconColor: 'text-brand-blue' },
};
---

<section id="skills" class="section-fade py-10 md:py-14">
  <div class="section-container">
    <div class="mb-7 max-w-3xl space-y-3 md:mb-8">
      <p class="section-eyebrow">Skills</p>
      <h2 class="section-heading">Technical strengths &amp; tools</h2>
      <p class="section-subheading">
        Technologies and platforms organized by specialty. Click any tool to visit its official site.
      </p>
    </div>

    <div class="space-y-6">
      {
        skillCategories.map((category) => (
          <article class="card-surface overflow-hidden">
            <div class="border-b border-border/80 bg-surface-muted/70 px-5 py-5 sm:px-7">
              <div class="flex items-start gap-4">
                <div
                  class:list={[
                    'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl ring-1',
                    categoryIcons[category.id].bg,
                    categoryIcons[category.id].ring,
                  ]}
                >
                  {category.id === 'marketing' && (
                    <svg class:list={['h-6 w-6', categoryIcons[category.id].iconColor]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                    </svg>
                  )}
                  {category.id === 'web' && (
                    <svg class:list={['h-6 w-6', categoryIcons[category.id].iconColor]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                    </svg>
                  )}
                  {category.id === 'design' && (
                    <svg class:list={['h-6 w-6', categoryIcons[category.id].iconColor]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125A2.25 2.25 0 0022.5 18.75v-10.5A2.25 2.25 0 0020.25 6H9.75" />
                    </svg>
                  )}
                  {category.id === 'productivity' && (
                    <svg class:list={['h-6 w-6', categoryIcons[category.id].iconColor]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
                    </svg>
                  )}
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-foreground sm:text-xl">{category.title}</h3>
                  <p class="mt-1 text-sm text-muted-dark">{category.description}</p>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 p-5 sm:grid-cols-3 sm:gap-4 sm:p-7 md:grid-cols-4 lg:grid-cols-6">
              {
                category.skills.map((skill) => (
                  <a
                    href={skill.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="skill-card group !gap-3 !p-4"
                    title={`Visit ${skill.name}`}
                  >
                    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#f4efe4] ring-1 ring-black/10 transition-all duration-300 group-hover:scale-105 group-hover:ring-gold/60 group-hover:shadow-md">
                      <SkillIcon skill={skill} class="h-10 w-10 transition-transform duration-300 group-hover:scale-110" />
                    </div>
                    <span class="text-center text-xs font-semibold leading-tight text-foreground transition-colors duration-300 group-hover:text-gold-light sm:text-sm">
                      {skill.name}
                    </span>
                  </a>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
