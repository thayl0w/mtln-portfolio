---
interface Props {
  href: string;
  image?: string;
  eyebrow: string;
  title: string;
  summary?: string;
}

const { href, image, eyebrow, title, summary } = Astro.props;
---

<a
  href={href}
  class="card-surface group flex h-full min-h-0 flex-col overflow-hidden transition-transform duration-300 hover:-translate-y-1"
>
  <div class="relative w-full shrink-0 overflow-hidden bg-surface-alt" style="aspect-ratio: 16 / 10;">
    {
      image ? (
        <img
          src={image}
          alt=""
          class="preview-protected h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          draggable="false"
        />
      ) : (
        <div class="flex h-full items-center justify-center">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-gold">{eyebrow}</p>
        </div>
      )
    }
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface/80 via-surface/15 to-transparent"></div>
  </div>
  <div class="flex min-h-0 flex-1 flex-col p-4">
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-gold">{eyebrow}</p>
    <h3 class="mt-1.5 min-h-[2.5rem] line-clamp-2 font-serif text-base font-semibold leading-snug text-foreground group-hover:text-gold-light sm:text-lg">
      {title}
    </h3>
    {
      summary ? (
        <p class="mt-1.5 min-h-[2.5rem] line-clamp-2 text-sm leading-snug text-muted">{summary}</p>
      ) : null
    }
  </div>
</a>
