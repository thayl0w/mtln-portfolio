---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { lumiereCaseStudy, site } from '../../data/portfolio';

const study = lumiereCaseStudy;
---

<Layout
  title={`${study.title} | ${site.name}`}
  description={study.summary}
>
  <Navbar revealImmediately />

  <main class="pb-16 pt-28 md:pt-36">
    <article class="section-container">
      <p class="section-eyebrow">{study.eyebrow}</p>
      <h1 class="mt-3 max-w-4xl font-serif text-[clamp(1.8rem,4vw,3.2rem)] font-semibold leading-tight text-foreground">
        {study.title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted md:text-lg">
        {study.summary}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={study.liveUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">Live project</a>
        <a href={study.githubUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">Source</a>
        <a href="/#work" class="btn-outline">Back to work</a>
      </div>

      <div class="card-surface mt-10 overflow-hidden">
        <img
          src={study.image}
          alt="LUMIÈRE Beauty & Wellness funnel homepage"
          class="h-auto w-full object-contain object-top"
        />
      </div>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          study.scope.map((item) => (
            <div class="card-surface p-5">
              <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-gold">{item.label}</dt>
              <dd class="mt-2 text-sm font-medium text-foreground">{item.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 grid gap-10 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="space-y-8">
          <section>
            <h2 class="font-serif text-2xl font-semibold text-foreground">Overview</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{study.overview}</p>
          </section>
          <section>
            <h2 class="font-serif text-2xl font-semibold text-foreground">The challenge</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{study.challenge}</p>
          </section>
          <section>
            <h2 class="font-serif text-2xl font-semibold text-foreground">My role</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{study.role}</p>
          </section>
          <section>
            <h2 class="font-serif text-2xl font-semibold text-foreground">Approach</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{study.approach}</p>
          </section>
          <section>
            <h2 class="font-serif text-2xl font-semibold text-foreground">Development</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{study.development}</p>
          </section>
          <section>
            <h2 class="font-serif text-2xl font-semibold text-foreground">Responsive strategy</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{study.responsive}</p>
          </section>
        </div>

        <aside class="space-y-6">
          <div class="card-surface p-6">
            <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Technologies</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {study.stack.map((item) => (
                <li class="rounded-full border border-border px-2.5 py-1 text-xs text-muted">{item}</li>
              ))}
            </ul>
          </div>

          <div class="card-surface p-6">
            <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Routes</h2>
            <ul class="mt-4 space-y-3">
              {study.pages.map((page) => (
                <li>
                  <a
                    href={page.href}
                    class="text-sm font-semibold text-foreground hover:text-gold-light"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {page.name}
                  </a>
                  <p class="text-xs text-muted">{page.note}</p>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-surface p-6">
            <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Technical decisions</h2>
            <ul class="mt-4 space-y-2">
              {study.technical.map((item) => (
                <li class="flex gap-2 text-sm text-muted">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
