---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { marketingCategories, getMarketingCategory, marketingCounts } from '../../data/marketing';
import { site } from '../../data/portfolio';
export function getStaticPaths(){return marketingCategories.map((category)=>({params:{category:category.id}}));}
const category=getMarketingCategory(Astro.params.category||'')!;const counts=marketingCounts(category);
---
<Layout title={`${category.title} | ${site.name}`} description={category.summary}>
<Navbar revealImmediately />
<main class="pb-16 pt-28 md:pt-36"><div class="section-container">
<p class="section-eyebrow">Marketing work</p><h1 class="mt-3 max-w-4xl font-serif text-[clamp(1.9rem,4vw,3.2rem)] font-semibold text-foreground">{category.title}</h1>
<p class="mt-4 max-w-3xl text-base leading-relaxed text-muted">{category.summary}</p><p class="mt-3 text-xs uppercase tracking-[0.16em] text-subtle">{counts.items} portfolio items · {counts.brands} brands</p>
<a href="/#marketing" class="btn-outline mt-6">Back to marketing library</a>
<div class="mt-12 space-y-10">{category.brands.map((brand)=>(<section id={brand.id} class="scroll-mt-28"><div class="mb-5 flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">Brand</p><h2 class="mt-2 font-serif text-2xl font-semibold text-foreground">{brand.brand}</h2><p class="mt-1 text-sm text-muted">{brand.deliverables.length} deliverable{brand.deliverables.length===1?'':'s'} in this work type.</p></div><a href={`/marketing/${category.id}/${brand.id}`} class="btn-outline">Open project window →</a></div><div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">{brand.deliverables.map((item)=>(<a href={`/marketing/${category.id}/${brand.id}`} class="card-surface group flex h-full flex-col overflow-hidden p-5 transition-transform hover:-translate-y-1"><p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-gold">{item.format}</p><h3 class="mt-2 text-lg font-semibold text-foreground group-hover:text-gold-light">{item.title}</h3><p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{item.summary}</p><div class="mt-4 flex flex-wrap gap-2">{item.tags.slice(0,3).map((tag)=><span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted">{tag}</span>)}</div></a>))}</div></section>))}</div>
</div></main><Footer /></Layout>
