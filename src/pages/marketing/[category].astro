---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CompactProjectCard from '../../components/CompactProjectCard.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';
import { marketingCategories, getMarketingCategory, marketingCounts, getMarketingWindows } from '../../data/marketing';
import { site } from '../../data/portfolio';

export function getStaticPaths() {
  return marketingCategories.map((category) => ({ params: { category: category.id } }));
}

const category = getMarketingCategory(Astro.params.category || '')!;
const counts = marketingCounts(category);
const projects = getMarketingWindows().filter((window) => window.category.id === category.id);
---

<Layout title={`${category.title} | ${site.name}`} description={category.summary}>
  <Navbar revealImmediately />
  <main class="pb-16 pt-28 md:pt-36">
    <div class="section-container">
      <p class="section-eyebrow">Marketing work</p>
      <h1 class="mt-3 max-w-4xl font-serif text-[clamp(1.9rem,4vw,3.2rem)] font-semibold text-foreground">
        {category.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted">{category.summary}</p>
      <p class="mt-3 text-xs uppercase tracking-[0.16em] text-subtle">
        {counts.projects} project{counts.projects === 1 ? '' : 's'} · {counts.brands} brand{counts.brands === 1 ? '' : 's'}
      </p>
      <a href="/#marketing" class="btn-outline mt-6">Back to marketing library</a>

      <div class="mt-10">
        <ProjectCarousel label={category.title}>
          {
            projects.map((project) => (
              <div class="carousel-card">
                <CompactProjectCard
                  href={project.href}
                  image={project.preview}
                  eyebrow={category.title}
                  title={project.brand}
                  summary={project.summary}
                />
              </div>
            ))
          }
        </ProjectCarousel>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
